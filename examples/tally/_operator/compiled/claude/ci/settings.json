{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr comment *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Edit(**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:forge.example.com)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/shell/secrets.sh)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf / *)",
      "Bash(dropdb *)",
      "Bash(docker volume rm *)",
      "Edit(**/.git/hooks/**)"
    ],
    "ask": [
      "Bash(psql *)",
      "Edit(deploy/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.config/shell/secrets.sh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org",
        "forge.example.com"
      ],
      "strictAllowlist": true
    }
  }
}
