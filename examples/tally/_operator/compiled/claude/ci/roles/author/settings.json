{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/shell/secrets.sh)",
      "Bash(git push --force *)",
      "Bash(*git* push* --force)",
      "Bash(*git* push* --force *)",
      "Bash(git push -f *)",
      "Bash(*git* push* -f)",
      "Bash(*git* push* -f *)",
      "Bash(git push --mirror *)",
      "Bash(*git* push* --mirror)",
      "Bash(*git* push* --mirror *)",
      "Bash(git push +*)",
      "Bash(*git* push* +*)",
      "Bash(rm -rf / *)",
      "Bash(dropdb *)",
      "Bash(docker volume rm *)",
      "Edit(**/.git/hooks/**)"
    ],
    "ask": [
      "Bash(psql *)",
      "Edit(deploy/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.ssh",
        "~/.config/shell/secrets.sh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org",
        "forge.example.com"
      ],
      "strictAllowlist": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/promptbook/forbid-guard.mjs\" \"$HOME/.claude/hooks/promptbook/forbid.json\""
          }
        ]
      }
    ]
  }
}
