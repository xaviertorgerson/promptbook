{
  "generated_by": "promptbook compile-policy",
  "source": "agent-policy.yaml",
  "profile": "workstation",
  "tier": "auto-edit",
  "rules": [
    {
      "command": [
        "git",
        "push"
      ],
      "flags_anywhere": [
        "--force",
        "-f",
        "--mirror",
        "+*"
      ],
      "reason": "no force-push of shared branches"
    },
    {
      "command": [
        "rm",
        "-rf",
        "/"
      ],
      "reason": "never wipe the root"
    },
    {
      "command": [
        "dropdb"
      ],
      "reason": "no destructive data actions"
    },
    {
      "command": [
        "docker",
        "volume",
        "rm"
      ],
      "reason": "volumes hold the only copy of local data"
    }
  ],
  "read_deny": [
    "**/.env",
    "**/.env.*",
    "**/secrets/**",
    "~/.ssh/**",
    "~/.config/shell/secrets.sh"
  ]
}
