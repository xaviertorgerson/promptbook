{
  "description": "harness forbid guard, compiled from agent-policy.yaml (profile laptop)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/harness/forbid-guard.mjs\" \"$HOME/.codex/hooks/harness/forbid.json\"",
            "statusMessage": "harness forbid guard"
          }
        ]
      }
    ]
  }
}
