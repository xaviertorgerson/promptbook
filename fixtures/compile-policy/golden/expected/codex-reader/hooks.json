{
  "description": "promptbook forbid guard, compiled from agent-policy.yaml (profile reader)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/promptbook/forbid-guard.mjs\" \"$HOME/.codex/hooks/promptbook/forbid.json\"",
            "statusMessage": "promptbook forbid guard"
          }
        ]
      }
    ]
  }
}
