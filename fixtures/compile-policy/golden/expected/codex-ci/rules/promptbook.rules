# Compiled from agent-policy.yaml (profile ci, tier unattended) by promptbook compile-policy.
# Most restrictive decision wins: forbidden > prompt > allow. Check: codex execpolicy check --rules <this file> -- <cmd>

prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "never wipe the root",
    match = ["rm -rf /"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--mirror"]],
    decision = "forbidden",
    justification = "no force-push of shared branches",
    match = ["git push --force origin main", "git push -f"],
)

prefix_rule(
    pattern = ["docker", "compose", "down", ["-v", "--volumes"]],
    decision = "forbidden",
    justification = "the stack's volumes hold its only data",
    match = ["docker compose down -v"],
)

prefix_rule(
    pattern = ["docker-compose", "down", ["-v", "--volumes"]],
    decision = "forbidden",
    justification = "the stack's volumes hold its only data",
    match = ["docker-compose down -v"],
)

prefix_rule(
    pattern = ["herdr", "workspace", "close"],
    decision = "forbidden",
    justification = "closing a workspace can end a worktree group",
    match = ["herdr workspace close w2"],
)

prefix_rule(
    pattern = ["psql"],
    decision = "forbidden",
    justification = "ask in an unattended tier is a denial: a database shell is a human checkpoint",
    match = ["psql"],
)

prefix_rule(
    pattern = ["git", ["status", "log", "diff"]],
    decision = "allow",
    justification = "allow in agent-policy.yaml",
    match = ["git status", "git log --oneline"],
)
