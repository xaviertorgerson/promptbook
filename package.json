{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "Engine-neutral contracts, state machines and validator for agent-driven software work (Layer 3).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harness": "tools/cli.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "validate": "node tools/validate.mjs",
    "trace": "node tools/validate.mjs --trace",
    "lint": "node tools/lint-skills.mjs",
    "simulate": "node tools/simulate.mjs",
    "compile-policy": "node tools/compile-policy.mjs",
    "run": "node tools/run.mjs",
    "check-requires": "node tools/check-requires.mjs",
    "lock": "node tools/lock.mjs",
    "grant": "node tools/grant.mjs",
    "eval-routing": "node tools/eval-routing.mjs",
    "import-evals": "node tools/import-evals.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
