{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.dev/schemas/evidence.schema.json",
  "title": "Skill evidence",
  "description": "Why a skill is the way it is, and how to tell whether it routes. Three artifacts: dated evidence entries in skills/<name>/evals/evidence.md; routing cases, one JSON object per line, in skills/<name>/evals/routing.jsonl; and routing results, one line per case and run, written by harness eval-routing --out (routing-results*.jsonl), the measured source an evidence entry cites.",
  "x-version": "1.2.0",
  "x-artifacts": [
    { "format": "markdown-entries", "parser": "evidence", "paths": ["skills/*/evals/evidence.md"], "pointer": "#/$defs/entry" },
    { "format": "jsonl", "paths": ["skills/*/evals/routing.jsonl"], "pointer": "#/$defs/routingCase" },
    { "format": "jsonl", "paths": ["routing-results*.jsonl"], "pointer": "#/$defs/routingResult" }
  ],
  "$defs": {
    "entry": {
      "description": "One '## YYYY-MM-DD · title' entry (or '## YYYY-MM · title' when only the month is known) with '- **Field:** value' bullets (CONTRACTS.md, Normalization). Every level-2 heading of evidence.md must be one.",
      "type": "object",
      "required": ["date", "title", "kind", "claim"],
      "properties": {
        "date": {
          "description": "A day, or a month when the source gives no day (a release month, a dated-by-month report).",
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/date" },
            { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$" }
          ]
        },
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "kind": {
          "description": "measured: we ran it. observed: we saw it in real work. incident: it went wrong. audit: a review found it. vendor-reported: a vendor's own claim (flagged as such). literature: published research.",
          "enum": ["measured", "observed", "incident", "audit", "vendor-reported", "literature"]
        },
        "source": {
          "description": "A URL, a repository path, a commit, or a run reference.",
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "claim": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "result": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "engine": { "$ref": "common.schema.json#/$defs/slug" },
        "model": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "skill_version": { "$ref": "common.schema.json#/$defs/semver" },
        "revisit": {
          "description": "When this evidence should be re-checked.",
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "allOf": [
        {
          "x-rule": "outside-evidence-cites-url",
          "description": "Outside evidence carries a citable URL.",
          "if": { "required": ["kind"], "properties": { "kind": { "enum": ["vendor-reported", "literature"] } } },
          "then": { "required": ["source"], "properties": { "source": { "pattern": "^https?://" } } }
        },
        {
          "x-rule": "measurement-cites-source",
          "description": "A measurement says where it can be reproduced from.",
          "if": { "required": ["kind"], "properties": { "kind": { "const": "measured" } } },
          "then": { "required": ["source"] }
        }
      ]
    },
    "routingResult": {
      "description": "One routing case run k times through one model (harness eval-routing --runner ... --runs k --out): every trial's answer and the verdict. pass is pass^k: every trial passed.",
      "type": "object",
      "required": ["skill", "case", "prompt", "expect", "model", "runs", "answers", "passes", "pass"],
      "properties": {
        "skill": { "$ref": "common.schema.json#/$defs/slug" },
        "case": {
          "description": "<skill>:<line> of the case in that skill's routing.jsonl.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[1-9][0-9]*$"
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "expect": { "enum": ["trigger", "no-trigger"] },
        "kind": { "enum": ["positive", "near-miss", "negative", null] },
        "route_to": { "type": ["string", "null"], "pattern": "^(?:none|[a-z0-9]+(?:-[a-z0-9]+)*)$" },
        "model": { "description": "The model, or the runner command when no model was named.", "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "runs": { "type": "integer", "minimum": 1 },
        "answers": {
          "description": "Per trial, the skill names the router chose (empty: none).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true }
        },
        "passes": { "type": "integer", "minimum": 0 },
        "pass": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "skill_version": { "$ref": "common.schema.json#/$defs/semver" }
      },
      "additionalProperties": false,
      "x-checks": ["routing-result-consistent"]
    },
    "routingCase": {
      "description": "One prompt and whether this skill should load for it, given only the installed skills' names and descriptions.",
      "type": "object",
      "required": ["prompt", "expect"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "expect": { "enum": ["trigger", "no-trigger"] },
        "kind": {
          "description": "near-miss: a prompt a neighbouring skill owns, the case that proves the boundary.",
          "enum": ["positive", "near-miss", "negative"]
        },
        "route_to": {
          "description": "For no-trigger: the skill that should load instead, or none.",
          "type": "string",
          "pattern": "^(?:none|[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "x-rule": "trigger-case-is-positive",
          "if": { "required": ["expect"], "properties": { "expect": { "const": "trigger" } } },
          "then": { "properties": { "route_to": false, "kind": { "const": "positive" } } }
        },
        {
          "x-rule": "near-miss-names-route",
          "if": { "required": ["kind"], "properties": { "kind": { "const": "near-miss" } } },
          "then": { "required": ["route_to"] }
        }
      ]
    }
  }
}
