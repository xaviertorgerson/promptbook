{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbook.dev/schemas/agent-setup-review.schema.json",
  "title": "Agent-setup review",
  "description": "The record the reviewing-agent-setup skill writes after a model release or a quarter: what was reviewed with which suite, the baseline, the ablations (one component removed per row) and the decisions they support. Markdown: a '# Agent-setup review — YYYY-MM-DD — <model or quarter>' title, '- **Field:** value' header bullets, and level-2 sections.",
  "x-version": "2.0.0",
  "x-artifacts": [
    { "format": "markdown-entries", "parser": "agent-setup-review", "paths": ["agent-setup-reviews/*.md"], "suffixes": [".agent-setup-review.md"] }
  ],
  "type": "object",
  "required": ["date", "label", "trigger", "reviewed", "suite", "trials", "sections"],
  "properties": {
    "date": { "$ref": "common.schema.json#/$defs/date" },
    "label": { "description": "The model release or the quarter reviewed.", "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "trigger": { "description": "A model release (with its date) or quarterly.", "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "reviewed": { "description": "Promptbook and pack versions under review, from toolkit.lock.", "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "suite": { "description": "The eval suite's commit and its counts (routing cases, scenarios, real-failure tasks).", "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "trials": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "spend": { "description": "Spend cap / spent.", "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "noise": { "description": "Baseline against baseline: the difference a result must exceed to count.", "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "sections": {
      "x-rule": "review-has-sections",
      "description": "The level-2 sections present. A review measures a baseline, ablates, decides and dates the playbook.",
      "type": "array",
      "items": { "enum": ["baseline", "effort-sweep", "full-setup", "ablations", "decisions", "playbook", "questions"] },
      "allOf": [
        { "contains": { "const": "baseline" } },
        { "contains": { "const": "ablations" } },
        { "contains": { "const": "decisions" } },
        { "contains": { "const": "playbook" } }
      ]
    },
    "ablations": {
      "description": "One component removed per row; each row ends in a decision.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "decision"],
        "properties": {
          "component": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "decision": { "x-rule": "ablation-has-decision", "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "description": "'- Removed: …', '- Kept (load-bearing): …', '- Kept (inconclusive): …', '- Re-routed: …' lines.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": { "$ref": "common.schema.json#/$defs/slug" },
          "text": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false
}
