{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.dev/schemas/readiness-report.schema.json",
  "title": "Readiness report",
  "description": "Generated by the trace check for one epic: whether its plan is complete enough to approve and build. Never hand-edited; regenerate it.",
  "x-version": "1.2.0",
  "x-artifacts": [
    { "format": "frontmatter-markdown", "paths": ["specs/*/readiness.md"], "suffixes": [".readiness.md"], "bind": { "epic": 1 } }
  ],
  "x-sections": [
    { "id": "verdict", "heading": "Verdict", "match": "^Verdict\\b" },
    { "id": "coverage", "heading": "Coverage", "match": "^Coverage\\b" },
    { "id": "gaps", "heading": "Gaps", "match": "^Gaps\\b" }
  ],
  "type": "object",
  "required": ["epic", "generator", "adoption", "epic_status", "verdict", "counts", "coverage", "gaps"],
  "properties": {
    "epic": { "$ref": "common.schema.json#/$defs/slug" },
    "generated_at": {
      "description": "When the trace ran. Left out (trace --no-timestamp) for a report committed with the plan, which its own commit dates.",
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "generator": {
      "description": "Tool and version, e.g. harness/validate@1.0.0.",
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_commit": {
      "description": "HEAD of the traced root when it is a git repository; left out with --no-timestamp.",
      "$ref": "common.schema.json#/$defs/gitSha"
    },
    "adoption": {
      "description": "full: docs/product/brief.md exists and every trace rule applies. legacy: the project predates the product docs; harness-introduced links are warnings.",
      "enum": ["full", "legacy"]
    },
    "epic_status": { "$ref": "common.schema.json#/$defs/epicStatus" },
    "verdict": { "enum": ["ready", "not-ready"] },
    "counts": {
      "type": "object",
      "required": ["error", "warning", "info"],
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["journeys", "requirements", "tasks", "criteria"],
      "properties": {
        "journeys": { "$ref": "#/$defs/ratio" },
        "requirements": { "$ref": "#/$defs/ratio" },
        "tasks": { "$ref": "#/$defs/ratio" },
        "criteria": { "$ref": "#/$defs/ratio" }
      },
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/traceGap" }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "allOf": [
    {
      "x-rule": "ready-has-no-blocking-gap",
      "description": "A ready verdict has no error and no gap that blocks readiness.",
      "if": { "required": ["verdict"], "properties": { "verdict": { "const": "ready" } } },
      "then": {
        "properties": {
          "counts": { "properties": { "error": { "const": 0 } } },
          "gaps": {
            "not": {
              "contains": {
                "anyOf": [
                  { "required": ["severity"], "properties": { "severity": { "const": "error" } } },
                  { "required": ["blocks_readiness"], "properties": { "blocks_readiness": { "const": true } } }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ratio": {
      "description": "covered of total: journeys with a task, requirements with a task, tasks citing a requirement, criteria named in a test.",
      "type": "object",
      "required": ["covered", "total"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
