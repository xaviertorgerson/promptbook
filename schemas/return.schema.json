{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.dev/schemas/return.schema.json",
  "title": "Return",
  "description": "A subagent's hand-back to the agent that dispatched it: a bounded summary, the artifacts it wrote, what it needs decided, and how it did against the criteria. Passed as a JSON object (e.g. a structured-output schema or a JSON file the dispatcher reads).",
  "x-version": "1.1.0",
  "x-artifacts": [
    { "format": "json", "paths": [".agent/returns/*.json"] }
  ],
  "type": "object",
  "required": ["summary", "attention", "artifacts", "decisions_needed"],
  "properties": {
    "task": {
      "description": "The workflow task id (<PREFIX>-<n>, the documented form) when the work has one; otherwise the runtime's stable id, as task-record.task_id accepts.",
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "role": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "summary": {
      "description": "What was done and found. About 2,000 tokens at most; 8,000 characters is the enforced ceiling.",
      "x-rule": "summary-within-budget",
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "attention": { "$ref": "common.schema.json#/$defs/attention" },
    "artifacts": {
      "description": "Paths (repository-relative) or URLs the subagent wrote or changed. The dispatcher reads these instead of a longer summary.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/docRef" },
          "kind": { "enum": ["code", "test", "doc", "spec", "report", "data", "pr", "commit", "other"] },
          "note": { "type": "string", "maxLength": 300 }
        },
        "additionalProperties": false
      }
    },
    "decisions_needed": {
      "description": "Questions only a human (or the dispatcher's grant) can answer. Non-empty exactly when attention is needs-human.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "options": { "type": "array", "items": { "type": "string" } },
          "recommendation": { "type": "string" },
          "blocking": { "type": "boolean" },
          "for": {
            "description": "Who decides.",
            "enum": ["human", "dispatcher"]
          }
        },
        "additionalProperties": false
      }
    },
    "criteria": {
      "description": "Acceptance criteria the subagent was given, each judged.",
      "type": "object",
      "required": ["met", "unmet"],
      "properties": {
        "met": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/criterionId" }, "uniqueItems": true },
        "unmet": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/criterionId" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "description": "Commands run to check the work, and their result.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "skipped"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "session": { "$ref": "common.schema.json#/$defs/sessionRef" }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "allOf": [
    {
      "x-rule": "needs-human-asks-a-question",
      "description": "needs-human comes with at least one question.",
      "if": { "required": ["attention"], "properties": { "attention": { "const": "needs-human" } } },
      "then": { "properties": { "decisions_needed": { "minItems": 1 } } }
    },
    {
      "x-rule": "complete-meets-every-criterion",
      "description": "complete means every criterion met.",
      "if": { "required": ["attention", "criteria"], "properties": { "attention": { "const": "complete" } } },
      "then": { "properties": { "criteria": { "properties": { "unmet": { "maxItems": 0 } } } } }
    }
  ]
}
